{
  "name": "goalport",
  "version": "1.0.0-rc.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.coordination.config.ts",
    "lint": "tsc -b --pretty false",
    "test": "pnpm test:unit && pnpm test:node",
    "test:unit": "vitest run --dir src && vitest run scripts/acceptance/lib/scenarios-readselectors.test.tsx",
    "test:runtime-preflight": "node --test scripts/runtime-live-safety.test.mjs",
    "test:connected-ipc": "node --test scripts/connected/ipc-client.test.mjs scripts/connected/strict-predicates.test.mjs",
    "tauri": "tauri",
    "build:id": "node scripts/verify.mjs build-id",
    "verify:runtime": "node scripts/verify.mjs runtime",
    "verify:ipc": "node scripts/verify.mjs ipc",
    "verify:connected": "node scripts/connected/verify-connected.mjs",
    "verify:soak": "node scripts/connected/verify-soak.mjs",
    "verify:desktop-compare": "node scripts/connected/verify-desktop-compare.mjs",
    "verify:launch": "node scripts/connected/verify-launch.mjs",
    "verify:raw-manifest": "node scripts/connected/verify-raw-manifest.mjs",
    "verify:select-second-runtime": "node scripts/connected/verify-select-second-runtime.mjs",
    "verify:handoff": "node scripts/connected/verify-handoff.mjs",
    "electron:dev": "electron .",
    "electron:package": "node scripts/connected/package-electron.mjs",
    "electron:start": "node scripts/desktop/start.mjs",
    "electron:verify": "node scripts/desktop/verify-package.mjs",
    "acceptance:windows": "node scripts/acceptance/windows-run.mjs",
    "test:desktop": "vite build --config vite.coordination.config.ts && node scripts/run-node-tests.mjs desktop",
    "test:release": "node scripts/run-node-tests.mjs release",
    "release:third-party-notices": "node scripts/release/generate-third-party-notices.mjs",
    "release:authenticode": "node scripts/release/authenticode-inventory.mjs",
    "release:bundle": "node scripts/release/build-release-bundle.mjs",
    "release:verify-bundle": "node scripts/release/verify-release-bundle.mjs",
    "tauri:build:release": "cargo build --release -p goalport-core -p goalport-core-launcher && tauri build --ci",
    "test:linux-client": "python3 -B -m unittest discover -s scripts/connected -p 'test_*.py'",
    "acceptance:execute-native": "node scripts/acceptance/execute-native.mjs",
    "test:acceptance-execution": "node --test scripts/acceptance/execute-native.test.mjs scripts/acceptance/lib/execution-fixture.test.mjs scripts/acceptance/stub-harness.test.mjs scripts/preview/execute-slice.test.mjs",
    "acceptance:feedback-native": "node scripts/acceptance/feedback-native.mjs",
    "test:acceptance-feedback": "node --test scripts/acceptance/feedback-native.test.mjs scripts/acceptance/lib/execution-fixture.test.mjs scripts/acceptance/stub-harness.test.mjs",
    "acceptance:plan-revision-native": "node scripts/acceptance/plan-revision-native.mjs",
    "test:acceptance-plan-revision": "node --test scripts/acceptance/plan-revision-native.test.mjs scripts/acceptance/lib/execution-fixture.test.mjs scripts/acceptance/stub-harness.test.mjs",
    "preview:verify-execution": "node scripts/preview/verify-execute-slice.mjs",
    "preview:shot-execution": "node scripts/preview/shot-execute-slice.mjs",
    "acceptance:background-native": "node scripts/acceptance/background-native.mjs",
    "test:acceptance-background": "vite build --config vite.coordination.config.ts && node --test electron/coordination-job.test.cjs electron/coordination-worker.test.cjs electron/coordination-background.test.cjs scripts/acceptance/background-native.test.mjs",
    "test:coordination": "vite build --config vite.coordination.config.ts && node --test electron/pi-capacity.test.cjs electron/workflow-checks.test.cjs electron/workflow-store.test.cjs electron/native-workspace-check.test.cjs electron/native-check-host.test.cjs electron/execution-workspace-evidence.test.cjs electron/coordination-record.test.cjs electron/coordination-job.test.cjs electron/coordination-background.test.cjs electron/coordination-worker.test.cjs electron/coordination-ipc.test.cjs scripts/connected/linux-coordinate.test.mjs",
    "test:node": "vite build --config vite.coordination.config.ts && node scripts/run-node-tests.mjs unit",
    "test:runtime-installed": "node --test scripts/verify-runtime-preflight.live.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tauri-apps/api": "2.11.1",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-packager": "17.1.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
